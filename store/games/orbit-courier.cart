api=2
id=orbit-courier
title=ORBIT COURIER
description=Pilot a courier through three accelerating satellite lanes.
type=SCRIPT
tick_ms=48
accent=56E5FF
--SCRIPT--
on|start
set|score|0
set|lives|3
set|level|1
set|courier_x|208
set|courier_y|146
set|hazard_speed|3
rect|0|$courier_x|$courier_y|20|20|56E5FF|5
rect|1|60|18|16|16|F356B8|8
velocity|1|0|$hazard_speed|wrap
rect|2|232|75|12|12|FFC857|6
velocity|2|0|$hazard_speed|wrap
rect|3|365|120|18|18|B9F66A|9
velocity|3|0|$hazard_speed|wrap
label|0|10|4|300|FFFFFF|SCORE $score    LIVES $lives    LV $level
label|1|14|158|420|8D9BB4|D-PAD MOVE     A: PULSE     B: RESET RUN
end

on|update
if|left
sub|courier_x|5
endif
if|right
add|courier_x|5
endif
if|up
sub|courier_y|4
endif
if|down
add|courier_y|4
endif
if|$courier_x|<|0
set|courier_x|0
endif
if|$courier_x|>|428
set|courier_x|428
endif
if|$courier_y|<|0
set|courier_y|0
endif
if|$courier_y|>|164
set|courier_y|164
endif
position|0|$courier_x|$courier_y
physics
add|score|1
collide|impact|0|1
if|impact|==|1
sub|lives|1
random|spawn_x|0|432
position|1|$spawn_x|0
endif
collide|impact|0|2
if|impact|==|1
sub|lives|1
random|spawn_x|0|436
position|2|$spawn_x|0
endif
collide|impact|0|3
if|impact|==|1
sub|lives|1
random|spawn_x|0|430
position|3|$spawn_x|0
endif
if|$score|>=|120
set|level|2
set|hazard_speed|4
velocity|1|0|$hazard_speed|wrap
velocity|2|0|$hazard_speed|wrap
velocity|3|0|$hazard_speed|wrap
endif
if|$score|>=|260
set|level|3
set|hazard_speed|5
velocity|1|0|$hazard_speed|wrap
velocity|2|0|$hazard_speed|wrap
velocity|3|0|$hazard_speed|wrap
endif
text|0|SCORE $score    LIVES $lives    LV $level
if|$lives|<=|0
over|RUN ENDED     //     PRESS A TO RETRY
endif
end

on|a
if|$lives|>|0
add|score|25
random|spawn_x|0|432
position|1|$spawn_x|0
random|spawn_x|0|436
position|2|$spawn_x|0
random|spawn_x|0|430
position|3|$spawn_x|0
endif
end

on|b
set|score|0
set|lives|3
set|level|1
set|hazard_speed|3
set|courier_x|208
set|courier_y|146
position|0|$courier_x|$courier_y
velocity|1|0|$hazard_speed|wrap
velocity|2|0|$hazard_speed|wrap
velocity|3|0|$hazard_speed|wrap
position|1|60|18
position|2|232|75
position|3|365|120
text|0|SCORE $score    LIVES $lives    LV $level
end
